<mvc:View
  controllerName="timesheet.app.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  displayBlock="true"
>
  <Shell id="shell">
    <App id="app">
      <Page title="{i18n>appTitle}" showHeader="true">
        <headerContent>
          <Label text="{i18n>actingAs}" class="sapUiTinyMarginEnd" />
          <Select
            id="userSelect"
            items="{ path: '/Employees', sorter: { path: 'lastName' } }"
            change="onUserChange"
            width="16rem"
          >
            <core:Item
              key="{ID}"
              text="{parts: [{path: 'firstName'}, {path: 'lastName'}, {path: 'isManager'}], formatter: '.formatEmployeeOption'}"
            />
          </Select>
        </headerContent>
        <content>
          <IconTabBar id="iconTabBar" expanded="true" class="sapUiResponsiveContentPadding">
            <items>
              <IconTabFilter key="my" text="{i18n>tabMyTimesheet}" icon="sap-icon://fob-watch-2">
                <mvc:XMLView viewName="timesheet.app.view.MyTimesheet" />
              </IconTabFilter>
              <IconTabFilter
                key="approvals"
                text="{i18n>tabApprovals}"
                icon="sap-icon://approvals"
                visible="{currentUser>/isManager}"
              >
                <mvc:XMLView viewName="timesheet.app.view.Approvals" />
              </IconTabFilter>
              <IconTabFilter
                key="cats"
                text="{i18n>tabCatsTransfer}"
                icon="sap-icon://synchronize"
                visible="{currentUser>/isManager}"
              >
                <mvc:XMLView viewName="timesheet.app.view.CatsTransfer" />
              </IconTabFilter>
            </items>
          </IconTabBar>
        </content>
      </Page>
    </App>
  </Shell>
</mvc:View>
