<mvc:View
  controllerName="timesheet.app.controller.MyTimesheet"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:cust="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
  xmlns="sap.m"
>
  <VBox class="sapUiResponsiveContentPadding">
      <Toolbar>
        <Title text="{i18n>tabMyTimesheet}" level="H2" />
        <ToolbarSpacer />
        <Button text="{i18n>newWeek}" type="Emphasized" press="onNewWeek" />
      </Toolbar>

      <Table
        id="headersTable"
        items="{ path: '/TimesheetHeaders', sorter: { path: 'weekStartDate', descending: true } }"
        growing="true"
        growingThreshold="20"
        noDataText="No timesheet weeks yet"
        mode="SingleSelectMaster"
        selectionChange="onHeaderSelect"
      >
        <columns>
          <Column><Text text="{i18n>colWeek}" /></Column>
          <Column><Text text="{i18n>colStatus}" /></Column>
          <Column hAlign="End"><Text text="{i18n>colTotalHours}" /></Column>
          <Column />
        </columns>
        <items>
          <ColumnListItem type="Active">
            <cells>
              <Text text="{weekStartDate}" />
              <ObjectStatus text="{status}" state="{path: 'status', formatter: '.formatStatusState'}" />
              <Text text="{totalHours}" />
              <Button
                text="{i18n>submitWeek}"
                type="Transparent"
                enabled="{path: 'status', formatter: '.isDraft', targetType: 'any'}"
                press="onSubmitWeek"
              />
            </cells>
          </ColumnListItem>
        </items>
      </Table>

      <Panel
        visible="{view>/hasSelection}"
        class="sapUiResponsiveMargin"
      >
        <headerToolbar>
          <Toolbar>
            <Title text="{path: 'view>/selectedHeaderWeekStart', formatter: '.formatWeekTitle'}" level="H3" />
            <ToolbarSpacer />
            <Button
              text="{i18n>addLine}"
              press="onAddRow"
              enabled="{path: 'view>/selectedHeaderStatus', formatter: '.isDraft', targetType: 'any'}"
            />
          </Toolbar>
        </headerToolbar>
        <Table
          id="gridTable"
          class="sapUiSizeCompact"
          noDataText="{i18n>msgNoAllocation}"
          items="{grid>/rows}"
        >
          <columns>
            <Column><Text text="{i18n>colCostCenterOrProject}" /></Column>
            <Column hAlign="Center"><Text text="{path: 'view>/selectedHeaderWeekStart', formatter: '.formatDayHeader0'}" /></Column>
            <Column hAlign="Center"><Text text="{path: 'view>/selectedHeaderWeekStart', formatter: '.formatDayHeader1'}" /></Column>
            <Column hAlign="Center"><Text text="{path: 'view>/selectedHeaderWeekStart', formatter: '.formatDayHeader2'}" /></Column>
            <Column hAlign="Center"><Text text="{path: 'view>/selectedHeaderWeekStart', formatter: '.formatDayHeader3'}" /></Column>
            <Column hAlign="Center"><Text text="{path: 'view>/selectedHeaderWeekStart', formatter: '.formatDayHeader4'}" /></Column>
            <Column hAlign="Center"><Text text="{path: 'view>/selectedHeaderWeekStart', formatter: '.formatDayHeader5'}" /></Column>
            <Column hAlign="Center"><Text text="{path: 'view>/selectedHeaderWeekStart', formatter: '.formatDayHeader6'}" /></Column>
            <Column hAlign="End"><Text text="{i18n>colTotal}" /></Column>
            <Column />
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <HBox>
                  <Select
                    visible="{grid>pending}" width="14rem"
                    selectedKey="{grid>selectedKey}"
                    change="onRowAllocationChange"
                    items="{path: 'grid>/allocationOptions', templateShareable: true}"
                  >
                    <core:Item key="{grid>key}" text="{grid>label}" />
                  </Select>
                  <Text visible="{= !${grid>pending} }" text="{grid>label}" />
                </HBox>
                <Input
                  type="Number" textAlign="Center" width="4rem"
                  value="{grid>cells/0/hours}"
                  editable="{grid>editable}"
                  valueState="{path: 'grid>cells/0/status', formatter: '.formatStatusState'}"
                  valueStateText="{grid>cells/0/rejectionReason}"
                  change="onCellHoursChange" cust:day="0"
                />
                <Input
                  type="Number" textAlign="Center" width="4rem"
                  value="{grid>cells/1/hours}"
                  editable="{grid>editable}"
                  valueState="{path: 'grid>cells/1/status', formatter: '.formatStatusState'}"
                  valueStateText="{grid>cells/1/rejectionReason}"
                  change="onCellHoursChange" cust:day="1"
                />
                <Input
                  type="Number" textAlign="Center" width="4rem"
                  value="{grid>cells/2/hours}"
                  editable="{grid>editable}"
                  valueState="{path: 'grid>cells/2/status', formatter: '.formatStatusState'}"
                  valueStateText="{grid>cells/2/rejectionReason}"
                  change="onCellHoursChange" cust:day="2"
                />
                <Input
                  type="Number" textAlign="Center" width="4rem"
                  value="{grid>cells/3/hours}"
                  editable="{grid>editable}"
                  valueState="{path: 'grid>cells/3/status', formatter: '.formatStatusState'}"
                  valueStateText="{grid>cells/3/rejectionReason}"
                  change="onCellHoursChange" cust:day="3"
                />
                <Input
                  type="Number" textAlign="Center" width="4rem"
                  value="{grid>cells/4/hours}"
                  editable="{grid>editable}"
                  valueState="{path: 'grid>cells/4/status', formatter: '.formatStatusState'}"
                  valueStateText="{grid>cells/4/rejectionReason}"
                  change="onCellHoursChange" cust:day="4"
                />
                <Input
                  type="Number" textAlign="Center" width="4rem"
                  value="{grid>cells/5/hours}"
                  editable="{grid>editable}"
                  valueState="{path: 'grid>cells/5/status', formatter: '.formatStatusState'}"
                  valueStateText="{grid>cells/5/rejectionReason}"
                  change="onCellHoursChange" cust:day="5"
                />
                <Input
                  type="Number" textAlign="Center" width="4rem"
                  value="{grid>cells/6/hours}"
                  editable="{grid>editable}"
                  valueState="{path: 'grid>cells/6/status', formatter: '.formatStatusState'}"
                  valueStateText="{grid>cells/6/rejectionReason}"
                  change="onCellHoursChange" cust:day="6"
                />
                <Text text="{grid>rowTotal}" />
                <Button
                  icon="sap-icon://decline"
                  type="Transparent"
                  tooltip="{i18n>removeLine}"
                  visible="{grid>pending}"
                  press="onRemoveRow"
                />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <Toolbar class="sapUiTinyMarginTop">
          <ToolbarSpacer />
          <Text text="{i18n>colGrandTotal}" class="sapUiSmallMarginEnd" />
          <Text text="{grid>/grandTotal}" class="sapUiSmallMarginEnd" />
        </Toolbar>
      </Panel>
  </VBox>
</mvc:View>
