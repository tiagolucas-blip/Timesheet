{
  "name": "timesheet",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/postgres": "^3",
    "@sap/cds": "^10",
    "@sap/cds-dk": "^10",
    "@sap/xssec": "^4",
    "pg": "^8"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@openui5/sap.f": "1.120",
    "@openui5/sap.m": "1.120",
    "@openui5/sap.ui.core": "1.120",
    "@openui5/sap.ui.layout": "1.120",
    "@openui5/themelib_sap_horizon": "1.120",
    "@ui5/cli": "^4.0.60"
  },
  "scripts": {
    "start": "cds-serve",
    "build:ui5": "cd app/timesheet && ui5 build --all --dest ../../dist-ui5",
    "deploy:vercel-db": "cds deploy --profile vercel"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "db": { "kind": "hana" },
        "auth": "xsuaa"
      },
      "[vercel]": {
        "db": { "kind": "postgres" },
        "auth": "mocked"
      },
      "html5-repo": true
    }
  }
}
